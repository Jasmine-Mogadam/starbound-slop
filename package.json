{
  "name": "starbound-deploy",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node scripts/start.js",
    "local:build": "docker compose build starbound",
    "local:up": "docker compose up -d",
    "local:down": "docker compose down",
    "local:logs": "docker compose logs -f starbound",
    "local:logs:playit": "docker compose logs -f playit",
    "local:claim": "docker compose run --rm playit",
    "setup": "flyctl apps create starbound-server && flyctl volumes create starbound_data --size 10 --region ord --yes",
    "deploy": "node scripts/deploy.js",
    "status": "flyctl status",
    "logs:fly": "flyctl logs",
    "ssh": "flyctl ssh console",
    "destroy": "flyctl apps destroy starbound-server"
  }
}
