# Steam credentials (only needed for fly.io deploy.js — not used by local docker compose)
STEAM_USER=your_steam_username
STEAM_PASS=your_steam_password
# STEAM_GUARD=123456

# playit.gg agent secret. Leave blank on first run, then `npm run local:claim`
# will print a claim URL. Visit it, finish setup on playit.gg, then paste the
# generated secret here.
PLAYIT_SECRET=
